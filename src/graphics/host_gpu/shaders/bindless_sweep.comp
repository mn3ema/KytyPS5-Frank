#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

// Diagnostic (KYTY_BINDLESS_SWEEP=1, v122/v124): once a frame, every allocated slot of one bindless
// image array: the size the GPU's descriptor reports (the host compares it with what it wrote:
// [bindless-verify]), and a texel from the first and the last page of the image, so a descriptor
// still naming a destroyed image's memory faults here, within a frame, instead of in whichever
// draw indexes it seconds later.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D      images_2d[];
layout(set = 1, binding = 1) uniform texture2DArray images_2d_array[];
layout(set = 1, binding = 2) uniform textureCube    images_cube[];
layout(set = 1, binding = 3) uniform texture3D      images_3d[];
layout(set = 1, binding = 7) uniform sampler        samplers[];

// Two words per slot ((binding * 65536 + slot) * 2): width | height << 16, and
// layers (or depth) | (frame & 0xffff) << 16, written after the fetches.
layout(std430, set = 0, binding = 0) buffer sink_buf {
    uint sink[];
};

layout(push_constant) uniform push {
    uint binding;
    uint count;
    uint frame;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    ivec3 size;
    vec4  first;
    vec4  last;
    if (pc.binding == 0u) {
        const ivec2 s = textureSize(images_2d[nonuniformEXT(i)], 0);
        size  = ivec3(s, 1);
        first = texelFetch(images_2d[nonuniformEXT(i)], ivec2(0), 0);
        last  = texelFetch(images_2d[nonuniformEXT(i)], s - 1, 0);
    } else if (pc.binding == 1u) {
        size  = textureSize(images_2d_array[nonuniformEXT(i)], 0);
        first = texelFetch(images_2d_array[nonuniformEXT(i)], ivec3(0), 0);
        last  = texelFetch(images_2d_array[nonuniformEXT(i)], size - 1, 0);
    } else if (pc.binding == 2u) {
        const ivec2 s = textureSize(images_cube[nonuniformEXT(i)], 0);
        size  = ivec3(s, 6);
        first = textureLod(samplerCube(images_cube[nonuniformEXT(i)], samplers[0]), vec3(1.0, 0.0, 0.0), 0.0);
        last  = textureLod(samplerCube(images_cube[nonuniformEXT(i)], samplers[0]), vec3(0.0, 0.0, -1.0), 0.0);
    } else {
        size  = textureSize(images_3d[nonuniformEXT(i)], 0);
        first = texelFetch(images_3d[nonuniformEXT(i)], ivec3(0), 0);
        last  = texelFetch(images_3d[nonuniformEXT(i)], size - 1, 0);
    }
    // The stores depend on the texels so the fetches stay; the NaN pattern never occurs.
    const uint tag = (floatBitsToUint(first.x) == 0x7fc00001u || floatBitsToUint(last.x) == 0x7fc00001u) ? 1u : 0u;
    const uint base = (pc.binding * 65536u + i) * 2u;
    sink[base]      = (uint(size.x) & 0xffffu) | (uint(size.y) << 16);
    sink[base + 1u] = ((uint(size.z) + tag) & 0xffffu) | ((pc.frame & 0xffffu) << 16);
}
